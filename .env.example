# ==============================================================================
# Environment Configuration Template for LMS (psoft-g1)
#
# In production/UAT/DEV on the DEI Linux VMs, systemd loads environment-specific
# configuration from /etc/psoft-g1/<env>.env (provisioned by deploy/setup-environments.sh).
#
# For local development overrides (e.g., changing PORT when port 8080 is used by Jenkins),
# copy this file to .env in the repository root. Spring Boot automatically imports
# .env if present (via spring.config.import=optional:file:.env[.properties]).
# ==============================================================================

# --- Application Runtime & Environment Metadata ---
PORT=8080
DEMO_ENVIRONMENT=local
SPRING_PROFILES_ACTIVE=bootstrap

# --- Database Connectivity ---
SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;IGNORECASE=TRUE
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=mysqluser
SPRING_DATASOURCE_PASSWORD=mysqlpass
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Security & Web Console ---
# Set to false in UAT and PROD (/etc/psoft-g1/uat.env and /etc/psoft-g1/prod.env)
SPRING_H2_CONSOLE_ENABLED=true

# --- JWT Cryptographic Keys ---
JWT_PRIVATE_KEY=classpath:rsa.private.key
JWT_PUBLIC_KEY=classpath:rsa.public.key

# --- File Storage & Uploads ---
FILE_UPLOAD_DIR=uploads-psoft-g1
FILE_PHOTO_MAX_SIZE=20000

# --- External API Integrations ---
NINJAS_API_KEY=a5nSlaa4JxIubY09H+NYuQ==cY9FegnFmAvYi6fN

# --- Bibliographic Sources (Comma-separated: googlebooks,openlibrary) ---
BIBLIOGRAPHIC_PROVIDERS=googlebooks,openlibrary
BIBLIOGRAPHIC_GOOGLEBOOKS_BASE_URL=https://www.googleapis.com/books/v1
BIBLIOGRAPHIC_OPENLIBRARY_BASE_URL=https://openlibrary.org
BIBLIOGRAPHIC_TIMEOUT_MS=3000

# --- Reader Notifications (email,sms,webhook) ---
NOTIFICATION_CHANNELS=email,sms,webhook
NOTIFICATION_WEBHOOK_URL=https://webhook.site/aa8be08d-93c1-407a-985a-c2f805e862e8
NOTIFICATION_WEBHOOK_TIMEOUT_MS=3000
NOTIFICATION_SMS_GATEWAY_URL=https://psoft-g1-sms-gateway.free.beeceptor.com/api/v1/sms/send
NOTIFICATION_SMS_TIMEOUT_MS=3000
NOTIFICATION_EMAIL_FROM=notifications@library.psoft.pt
SPRING_MAIL_HOST=sandbox.smtp.mailtrap.io
SPRING_MAIL_PORT=2525
MAILTRAP_USERNAME=your_mailtrap_username_here
MAILTRAP_PASSWORD=your_mailtrap_password_here

# --- Observability ---
MANAGEMENT_HEALTH_DETAILS=always

# --- Lending Policies (Setup time parameterization) ---
LENDING_POLICY_STANDARD_DAYS=15
LENDING_POLICY_STANDARD_MAX=3
LENDING_POLICY_STANDARD_FINE=200
LENDING_POLICY_STANDARD_MAX_RENEWALS=2
LENDING_POLICY_STANDARD_RENEWAL_DAYS=15

LENDING_POLICY_ADAPTIVE_MAX=5
LENDING_POLICY_ADAPTIVE_FIRST_THRESHOLD=1
LENDING_POLICY_ADAPTIVE_SECOND_THRESHOLD=2
LENDING_POLICY_ADAPTIVE_LONG_DAYS=30
LENDING_POLICY_ADAPTIVE_STANDARD_DAYS=15
LENDING_POLICY_ADAPTIVE_SHORT_DAYS=7
LENDING_POLICY_ADAPTIVE_MAX_RENEWALS=2
LENDING_POLICY_ADAPTIVE_RENEWAL_DAYS=15
LENDING_POLICY_ADAPTIVE_FINE=200

LENDING_POLICY_SELECTION_HISTORY_PERIOD_MONTHS=6
LENDING_POLICY_MIN_COMPLETED=3
LENDING_POLICY_MIN_ON_TIME_RATIO=80.0

LENDING_POLICY_LONG_TERM_DAYS=30
LENDING_POLICY_LONG_TERM_MAX=5
LENDING_POLICY_LONG_TERM_FINE=100

LENDING_POLICY_SHORT_TERM_DAYS=7
LENDING_POLICY_SHORT_TERM_MAX=5
LENDING_POLICY_SHORT_TERM_FINE=400

LENDING_POLICY_PREMIUM_DAYS=30
LENDING_POLICY_PREMIUM_MAX=5
LENDING_POLICY_PREMIUM_FINE=100
