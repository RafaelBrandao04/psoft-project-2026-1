// .Jenkinsfile_prod
// Pipeline for PROD Job (Final Continuous Delivery to Live Production Environment)
// Parameterized project triggered by UAT Job after human approval (does NOT run on Git push)

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'UAT_BUILD', defaultValue: '1', description: 'Build number of the upstream UAT job that accepted this release')
        string(name: 'UAT_JOB', defaultValue: 'lms-uat', description: 'Name of the upstream UAT job')
    }

    environment {
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8 -Djava.awt.headless=true'
    }

    stages {
        stage('Deploy PROD') {
            steps {
                echo ">>> Stage 1: Retrieving accepted artifact from UAT (Job: ${params.UAT_JOB}, Build: #${params.UAT_BUILD})"
                script {
                    // 1. Validate UAT_BUILD parameter
                    if (!(params.UAT_BUILD =~ /^[1-9][0-9]*$/)) {
                        error "Invalid UAT_BUILD parameter: '${params.UAT_BUILD}'. Must be a positive integer."
                    }

                    // 2. Clean local directories
                    dir('artifact') {
                        deleteDir()
                    }
                    dir('final_artifact') {
                        deleteDir()
                    }

                    // 3. Copy accepted artifacts from upstream UAT job
                    echo "Copying accepted artifacts from '${params.UAT_JOB}' Build #${params.UAT_BUILD}..."
                    copyArtifacts projectName: params.UAT_JOB,
                                  selector: specific(params.UAT_BUILD),
                                  filter: 'accepted/**',
                                  target: 'artifact',
                                  flatten: true

                    // 4. Verify presence of all required artifacts and audit properties
                    if (!fileExists('artifact/app.jar')) {
                        error "artifact/app.jar missing from accepted folder! UAT Build #${params.UAT_BUILD} did not supply an artifact."
                    }
                    if (!fileExists('artifact/release.properties')) {
                        error "artifact/release.properties missing from accepted folder!"
                    }
                    if (!fileExists('artifact/acceptance.properties')) {
                        error "artifact/acceptance.properties missing from accepted folder!"
                    }

                    def releaseProps = readProperties file: 'artifact/release.properties'
                    def acceptanceProps = readProperties file: 'artifact/acceptance.properties'

                    echo "=========================================================="
                    echo ">>> PRODUCTION AUDIT TRAIL:"
                    echo "  Original CI Job:    ${releaseProps['job']}"
                    echo "  Original CI Build:  #${releaseProps['build']}"
                    echo "  Git Commit Hash:    ${releaseProps['commit']}"
                    echo "  Accepted In UAT By: ${acceptanceProps['accepted_by']}"
                    echo "  UAT Approval Time:  ${acceptanceProps['approval_timestamp']}"
                    echo "=========================================================="

                    // 5. Deploy to Production on DEI VM vs806 (port 8080)
                    def common = load '.Jenkinsfile_common.groovy'
                    common.deploy('prod')

                    // 6. Record final production deployment metadata in final_artifact/
                    def nowIso = new Date().format("yyyy-MM-dd'T'HH:mm:ssZ")
                    def prodContent = "deployed_to=prod\nprod_job=${env.JOB_NAME}\nprod_build=${env.BUILD_NUMBER}\ndeployment_timestamp=${nowIso}\n"
                    writeFile file: 'artifact/prod_deployment.properties', text: prodContent, encoding: 'UTF-8'

                    if (isUnix()) {
                        sh '''
                            mkdir -p final_artifact
                            cp artifact/* final_artifact/
                        '''
                    } else {
                        bat '''
                            if not exist final_artifact mkdir final_artifact
                            copy artifact\\* final_artifact\\
                        '''
                    }

                    // 7. Archive final production release bundle
                    archiveArtifacts artifacts: 'final_artifact/**', fingerprint: true, allowEmptyArchive: false
                }
            }
        }
    }

    post {
        always {
            echo "PROD Pipeline finished with status: ${currentBuild.currentResult}"
        }
        success {
            echo "=========================================================="
            echo ">>> PRODUCTION DEPLOYMENT SUCCESSFUL!"
            echo ">>> The verified, tested, and human-approved LMS release is now LIVE on DEI VM vs806 (port 8080)!"
            echo "=========================================================="
        }
        failure {
            echo ">>> PRODUCTION DEPLOYMENT FAILED! Check console log for details."
        }
    }
}

