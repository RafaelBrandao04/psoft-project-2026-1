@startuml VP_N2_CreateLending
title Process View (Level 2) - Create Lending (To-Be)

autonumber
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam roundCorner 8

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #2563EB
    ActorBackgroundColor #EFF6FF
    ActorFontColor #1E3A8A
    LifeLineBorderColor #3B82F6
    LifeLineBackgroundColor #DBEAFE
    ParticipantBorderColor #2563EB
    ParticipantBackgroundColor #EFF6FF
    ParticipantFontColor #1E3A8A
    GroupBorderColor #2563EB
    GroupBackgroundColor #EFF6FF
    GroupBodyBackgroundColor #F8FAFC
    GroupHeaderFontColor #1E3A8A
    GroupFontColor #1E3A8A
}

actor "Librarian" as Actor
participant "<<component>>\nBackend" as Backend
participant "<<component>>\nDB" as DB
participant "<<external>>\nSMS Gateway" as Sms
participant "<<external>>\nSMTP Server" as Smtp
participant "<<external>>\nWebhook Server" as Webhook

activate Actor
Actor -> Backend: POST /api/lendings (resource)
activate Backend

Backend -> DB: check reader's active lendings & reader history
activate DB
DB --> Backend: active lendings, reader history
deactivate DB

Backend -> DB: get book and reader details
activate DB
DB --> Backend: book, reader
deactivate DB

Backend -> Backend: resolve lending policy using reader history
Backend -> Backend: validate limits & calculate dynamic duration

Backend -> DB: get current year count & save new lending
activate DB
DB --> Backend: saved lending
deactivate DB

opt reader notification channels active
    Backend ->o Sms: dispatch notification
    Backend ->o Smtp: dispatch notification
    Backend ->o Webhook: dispatch notification
end

Backend --> Actor: 201 Created (lending)
deactivate Backend
deactivate Actor

@enduml
