@startuml VP_N2_Top5BooksLent
title Process View (Level 2) - Get Top 5 Books Lent (As-Is)

autonumber
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam roundCorner 8

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #2563EB
    ActorBackgroundColor #EFF6FF
    ActorFontColor #1E3A8A
    LifeLineBorderColor #3B82F6
    LifeLineBackgroundColor #DBEAFE
    ParticipantBorderColor #2563EB
    ParticipantBackgroundColor #EFF6FF
    ParticipantFontColor #1E3A8A
}

actor "Librarian" as Actor
participant "<<component>>\nBackend" as Backend
participant "<<component>>\nDB" as DB

activate Actor
Actor -> Backend: GET /api/books/top5
activate Backend

Backend -> DB: get top 5 most lent books in the last year
activate DB
DB --> Backend: top 5 books with lending counts
deactivate DB

Backend --> Actor: 200 OK (top 5 books)
deactivate Backend
deactivate Actor

@enduml
