@startuml VP_N2_CreateLending
title Process View (Level 2) - Create Lending (As-Is)

autonumber
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam roundCorner 8

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #2563EB
    ActorBackgroundColor #EFF6FF
    ActorFontColor #1E3A8A
    LifeLineBorderColor #3B82F6
    LifeLineBackgroundColor #DBEAFE
    ParticipantBorderColor #2563EB
    ParticipantBackgroundColor #EFF6FF
    ParticipantFontColor #1E3A8A
}

actor "Librarian" as Actor
participant "<<component>>\nBackend" as Backend
participant "<<component>>\nDB" as DB

activate Actor
Actor -> Backend: POST /api/lendings (resource)
activate Backend

Backend -> DB: check reader's active lendings
activate DB
DB --> Backend: active lendings
deactivate DB

Backend -> DB: get book and reader details
activate DB
DB --> Backend: book, reader
deactivate DB

Backend -> DB: get current year lending count
activate DB
DB --> Backend: count
deactivate DB

Backend -> DB: save new lending
activate DB
DB --> Backend: saved lending
deactivate DB

Backend --> Actor: 201 Created (lending)
deactivate Backend
deactivate Actor

@enduml
